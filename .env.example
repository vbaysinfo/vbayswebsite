# ─── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.vbaysinteriors.com

# ─── Google Apps Script API (server-side only — never NEXT_PUBLIC) ──
# Web App URL from Apps Script → Deploy → New deployment → Web app
APPS_SCRIPT_URL=
# Must match the API_SECRET Script Property in Apps Script
APPS_SCRIPT_SECRET=
# Secret for POST /api/revalidate (refresh website cache after editing Sheets)
REVALIDATE_SECRET=

# ─── Admin login (server-side only) ──────────────────
# Comma-separated users: username:password:role   (role = admin | staff)
ADMIN_USERS=admin:change-me-please:admin
# Random 32+ char string used to sign admin session cookies
ADMIN_SESSION_SECRET=

# ─── Analytics / SEO ─────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── Anti-spam (optional Cloudflare Turnstile) ───────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_SHEET_URL=
